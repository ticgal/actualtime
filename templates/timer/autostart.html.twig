{# Autostart switch of the new task form #}

{% set field %}
    <div id="actualtime_autostart" class="form-field row col-12 mb-2">
        <label class="col-form-label col-2 text-xxl-end" for="autostart">
            <i class="ti ti-stopwatch me-1" title="{{ __('Autostart', 'actualtime') }}"></i>
        </label>
        <div class="col-10 field-container">
            <label class="form-check form-switch mt-2">
                <input type="hidden" name="autostart" value="0">
                <input type="checkbox" id="autostart" name="autostart" value="1" class="form-check-input">
            </label>
        </div>
    </div>
{% endset %}

<script>
    $(function() {
        if ($('#actualtime_autostart').length == 0) {
            $("#new-{{ itemtype|e('js') }}-block div.itiltask form > div.row div.row").first().append({{ field|json_encode|raw }});
        }
    });
</script>
