{# "Assign to me" button of a task assigned to another technician #}

{% set button %}
    <button id="actualtime_addme_{{ rand }}" form="actualtime_form_addme_{{ rand }}" type="submit" name="update"
            class="btn btn-icon btn-sm btn-ghost-secondary float-end mt-1 ms-1" title="{{ __('Associate myself') }}">
        <i class="ti ti-user-plus"></i>
    </button>
{% endset %}

{% set form %}
    <form method="POST" action="{{ form_url }}" class="d-none" id="actualtime_form_addme_{{ rand }}" data-submit-once>
        <input type="hidden" name="id" value="{{ task_id }}">
        <input type="hidden" name="itemtype" value="{{ parent_itemtype }}">
        <input type="hidden" name="users_id_tech" value="{{ users_id }}">
        <input type="hidden" name="{{ parent_key }}" value="{{ parent_id }}">
    </form>
{% endset %}

<script>
    $(function() {
        if ($('#actualtime_addme_{{ rand }}').length == 0) {
            $("div[data-itemtype='{{ itemtype|e('js') }}'][data-items-id='{{ task_id }}'] div.itiltask form select[name='users_id_tech']")
                .parent().append({{ button|json_encode|raw }});
        }
        if ($('#actualtime_form_addme_{{ rand }}').length == 0) {
            $('#itil-object-container').parent().append({{ form|json_encode|raw }});
        }
    });
</script>
